{
	"name": "catdat",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:remote": "vite dev --mode prod",
		"dev:host": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"prepare": "husky",
		"cspell": "pnpm exec cspell content/ database/",
		"db:shell": "sqlite3 database/catdat.db",
		"db:setup": "tsx --tsconfig database/tsconfig.json database/scripts/setup.ts",
		"db:seed": "tsx --tsconfig database/tsconfig.json database/scripts/seed.ts",
		"db:text": "tsx --tsconfig database/tsconfig.json database/scripts/text.ts",
		"db:deduce": "tsx --tsconfig database/tsconfig.json database/scripts/deduce.ts",
		"db:test": "tsx --tsconfig database/tsconfig.json database/scripts/test.ts",
		"db:snapshot": "tsx --tsconfig database/tsconfig.json database/scripts/snapshot.ts",
		"db:update": "tsx --tsconfig database/tsconfig.json database/scripts/update.ts",
		"db:redundancies": "tsx --tsconfig database/tsconfig.json database/scripts/redundancies.ts",
		"db:combinations": "tsx --tsconfig database/tsconfig.json database/scripts/combinations.ts",
		"e2e": "PUBLIC_PLAYWRIGHT=true pnpm exec playwright test",
		"e2e:debug": "PUBLIC_PLAYWRIGHT=true pnpm exec playwright test --debug",
		"e2e:ui": "PUBLIC_PLAYWRIGHT=true pnpm exec playwright test --ui"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-netlify": "^6.0.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/katex": "^0.16.8",
		"@types/node": "^26.6.3",
		"chokidar": "^5.0.0",
		"cspell": "^10.3.4",
		"dotenv": "^18.0.4",
		"gray-matter": "^4.0.3",
		"highlight.js": "^11.12.0",
		"husky": "^9.1.7",
		"markdown-it": "^15.0.2",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.1"
	},
	"engines": {
		"node": ">=24.14.0"
	},
	"dependencies": {
		"@fortawesome/free-regular-svg-icons": "^7.3.1",
		"@fortawesome/free-solid-svg-icons": "^7.3.1",
		"better-sqlite3": "^13.0.3",
		"katex": "^0.17.0",
		"svelte-fa": "^4.0.4",
		"valibot": "^1.5.0",
		"yaml": "^2.9.1"
	}
}
